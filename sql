create table applications (
  id bigint generated by default as identity primary key,
  full_name text not null,
  email text not null unique,
  phone text not null,
  address text not null,
  occupation text,
  reason text,
  status text default 'pending' check (status in ('pending','approved','rejected','registered')),
  created_at timestamptz default now()
);

create table profiles (
  id uuid references auth.users on delete cascade primary key,
  full_name text,
  email text,
  role text default 'member' check (role in ('member','admin')),
  membership_no text unique,
  created_at timestamptz default now()
);

alter table applications enable row level security;
alter table profiles enable row level security;

create policy "public_apply" on applications for insert to anon with check (true);
create policy "own_profile" on profiles for select to authenticated using (auth.uid() = id);
create policy "insert_own_profile" on profiles for insert to authenticated with check (auth.uid() = id);